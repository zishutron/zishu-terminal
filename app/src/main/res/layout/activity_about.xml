<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/zishu_launcher"
            android:contentDescription="@string/app_name"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Zishu Terminal"
            android:textColor="@color/term_dark_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_version_label"
            android:textColor="@color/term_dark_fg"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/app_channel"
            android:textColor="#FFFFAA55"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="An advanced Android terminal and developer environment built by ZISHU TRON.\n\nThe app, its interface and its commands are original work by ZISHU TRON."
            android:textColor="@color/term_dark_fg"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Linux userspace and packages (bash, Python, Git, SSH, Node.js, C/C++) are built from the Termux project's termux-packages (termux.dev) and installed with zbootstrap and pkg. Each package keeps its own open-source license.\n\nZishu Terminal is not affiliated with or endorsed by Termux.\nSee NOTICE.md in the project repository for licenses and source code."
            android:textColor="#FF999999"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
